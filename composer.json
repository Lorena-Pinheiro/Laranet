{
    "name": "lorena-pinheiro/laranet",
    "description": "A PHP framework built from scratch for learning, inspired by Laravel and .NET (hence the name :P)",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Laranet\\": "src/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
